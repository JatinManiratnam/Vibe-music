# Vibe Music — Frontend Environment Variables
# Copy this file to .env.local and fill in your values.
# CRA reads REACT_APP_* variables at build time.

# ── Backend API URL ───────────────────────────────────────────────
# Local development (default if unset):  http://localhost:5000/api
# Production (Render backend):           https://your-backend.onrender.com/api
REACT_APP_API_URL=
