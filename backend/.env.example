# Vibe Music — Backend Environment Variables
# Copy this file to .env and fill in your values. Never commit .env.

# ── Server ──────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development         # Set to "production" on Render/server

# ── MongoDB Atlas ────────────────────────────────────────────────
MONGO_URI=                   # mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<db>

# ── JWT ──────────────────────────────────────────────────────────
# Production requires a strong, random cryptographic secret (min 32 chars).
# Do NOT use the local development placeholder in production.
# To generate a strong secret, run this in your terminal:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ── Backblaze B2 Storage ─────────────────────────────────────────
B2_ENDPOINT=                 # e.g. https://s3.us-east-005.backblazeb2.com
B2_BUCKET_NAME=              # Your B2 bucket name
B2_KEY_ID=                   # B2 application key ID
B2_APPLICATION_KEY=          # B2 application key secret

# ── CORS ─────────────────────────────────────────────────────────
# Your production frontend URL (Vercel deployment).
# localhost:3000 is always allowed — no need to set it here.
# For multiple origins separate with commas:
#   FRONTEND_URL=https://myapp.vercel.app,https://www.mydomain.com
FRONTEND_URL=

# ── Recommendation System ────────────────────────────────────────
# Set to "true" in development for recommendation debug logs.
# Must be "false" or unset in production.
RECOMMENDATION_DEBUG=false
